# deploy/nginx.conf.example
# Salin ke /etc/nginx/sites-available/pickleball lalu:
#   sudo ln -s /etc/nginx/sites-available/pickleball /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Lalu jalankan certbot untuk HTTPS:
#   sudo certbot --nginx -d DOMAIN_ANDA

server {
    listen 80;
    server_name DOMAIN_ANDA;

    # Upload gambar maksimal 6MB (server action juga punya limit sendiri)
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MATCH_ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String
  image     String?
  published Boolean @default(false)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  comments Comment[]

  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String

  posts Post[]
}

model Comment {
  id      Int    @id @default(autoincrement())
  content String

  postId Int
  post   Post @relation(fields: [postId], references: [id])
}

// Definisi Status Turnamen biar rapi dan nggak salah ketik
enum TournamentStatus {
  DRAFT       // Masih dikonsep, belum tayang
  UPCOMING    // Akan datang / Pendaftaran buka
  ONGOING     // Sedang berlangsung
  COMPLETED   // Sudah selesai
  CANCELED    // Dibatalkan
}

// Status Pertandingan
enum MatchStatus {
  SCHEDULED   // Belum dimulai
  ONGOING     // Sedang berlangsung
  DONE        // Sudah selesai
}

// ============================================================
// ENUM SISTEM KATEGORI BARU
// ============================================================

// Jenis kelamin pemain
enum Gender {
  MALE    // Putra
  FEMALE  // Putri
}

// Tipe pertandingan
enum MatchType {
  SINGLE  // Tunggal (1 vs 1)
  DOUBLE  // Ganda (2 vs 2, gender sama)
  MIXED   // Ganda campuran (1 MALE + 1 FEMALE per tim)
}

// Status Pool
enum PoolStatus {
  OPEN      // Masih bisa menerima anggota baru
  FULL      // Sudah penuh, siap generate matches
  COMPLETED // Semua pertandingan pool selesai
}

// ============================================================
// TOURNAMENT
// ============================================================

model Tournament {
  id              Int              @id @default(autoincrement())
  name            String           // Contoh: "Jakarta Pickleball Open 2026"
  slug            String           @unique // Untuk URL: "jakarta-pickleball-open-2026"
  description     String?          @db.Text
  location        String
  category        String?
  image           String?
  startDate       DateTime
  endDate         DateTime
  registrationFee Int              @default(0)
  prizePool       String?
  maxParticipants Int
  poolSize        Int              @default(8) // Jumlah member per pool (default 8)
  // Tingkat (grade) yang tersedia untuk turnamen ini, format JSON array,
  // misal '["SD","SMP","SMA","OPEN","U19"]'. null = default (SD, SMP, SMA)
  gradeOptions    String?
  status          TournamentStatus @default(DRAFT)
  // Arsip (soft delete): null = aktif, terisi = diarsipkan
  deletedAt       DateTime?
  // Kode akses wasit: 1 kode per turnamen (semua wasit di turnamen yang sama memakai kode yang sama)
  refereeCode     String?
  // Status aktif kode akses wasit untuk turnamen ini
  isCodeActive    Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  players         Player[]
  teams           Team[]
  groups          TournamentGroup[]
  knockoutMatches KnockoutMatch[]
  pools           Pool[]
}

model Club {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  logo        String?
  location    String?
  contact     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// KONFIGURASI METODE PEMBAYARAN — diatur oleh SUPER_ADMIN
// ============================================================

model PaymentMethodConfig {
  id          Int      @id @default(autoincrement())
  method      String   // TRANSFER, QRIS, EWALLET, VENUE
  label       String   // Nama tampil: "Transfer Bank", "QRIS", "E-Wallet", "Bayar di Tempat"
  image       String?  // URL gambar QRIS / E-Wallet (opsional)
  active      Boolean  @default(true)
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PEMBAYARAN PENDAFTARAN
// v1: manual — transfer ke rekening panitia, bukti diupload,
//     admin konfirmasi. Kolom paymentOrderId "cadangan" agar
//     mudah di-upgrade ke payment gateway (mis. Midtrans).
// ============================================================

enum PaymentMethod {
  TRANSFER
  QRIS
  EWALLET
  VENUE // Bayar di tempat (venue) — dikonfirmasi panitia
}

enum PaymentStatus {
  UNPAID
  PAID
}

// ============================================================
// MODEL PLAYER — Dengan sistem kategori baru (typed enums)
// ============================================================

model Player {
  id          Int       @id @default(autoincrement())
  fullName    String    // Nama lengkap pemain
  schoolName  String    // Nama sekolah / instansi
  phoneNumber String    // No HP
  gender      Gender    // MALE / FEMALE
  grade       String    // Tingkat: SD / SMP / SMA / OPEN / U-19, dll (bebas)
  matchType   MatchType // SINGLE / DOUBLE / MIXED

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  seedOrder    Int?   // Urutan seed manual oleh admin

  // Referensi ke Team (untuk DOUBLE & MIXED)
  teamId       Int?
  team         Team?  @relation(fields: [teamId], references: [id])

  // Pembayaran (SINGLE disimpan di sini; DOUBLE/MIXED di Team)
  paymentMethod      PaymentMethod?
  paymentStatus      PaymentStatus?
  paymentConfirmedAt DateTime?
  paymentProof       String? // path gambar bukti transfer
  paymentOrderId     String? // cadangan untuk payment gateway

  poolMembers  PoolMember[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// MODEL TEAM — Untuk DOUBLE & MIXED (2 player per tim)
// ============================================================

model Team {
  id           Int       @id @default(autoincrement())
  name         String    // Nama tim, misal: "Budi & Andi"
  matchType    MatchType // DOUBLE atau MIXED
  grade        String    // Tingkat (bebas)

  // categoryKey: "SMA_MALE_DOUBLE" atau "SMA_MIXED"
  categoryKey  String

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  players      Player[]
  poolMembers  PoolMember[]

  // Pembayaran tim (DOUBLE & MIXED = 1x per tim)
  paymentMethod      PaymentMethod?
  paymentStatus      PaymentStatus?
  paymentConfirmedAt DateTime?
  paymentProof       String? // path gambar bukti transfer
  paymentOrderId     String? // cadangan untuk payment gateway

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tournamentId, categoryKey])
}

// ============================================================
// SISTEM POOL (GROUP STAGE) — Berbasis Kategori Otomatis
// ============================================================

// Pool adalah grup stage untuk satu kombinasi kategori
// Contoh: Pool A SMA Putra Single, Pool B SMA Putra Single
model Pool {
  id           Int        @id @default(autoincrement())
  label        String     // "Pool A SMA Putra Single"
  poolCode     String     // "A", "B", "C" — urutan dalam kategori

  // Key kategori canonical: "SMA_MALE_SINGLE", "SMP_FEMALE_DOUBLE", "SMA_MIXED"
categoryKey  String

  grade        String   // Tingkat (bebas)
  gender       Gender?  // null untuk MIXED
  matchType    MatchType

  maxSize      Int        @default(8)
  status       PoolStatus @default(OPEN)

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  members      PoolMember[]
  matches      PoolMatch[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tournamentId, categoryKey])
}

// Anggota pool — player (SINGLE) atau team (DOUBLE/MIXED)
model PoolMember {
  id           Int      @id @default(autoincrement())

  poolId       Int
  pool         Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)

  memberName   String   // Nama tampilan

  // Referensi ke player (SINGLE) atau team (DOUBLE/MIXED)
  playerId     Int?
  player       Player?  @relation(fields: [playerId], references: [id])

  teamId       Int?
  team         Team?    @relation(fields: [teamId], references: [id])

  // Statistik round-robin
  played       Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  pointsFor    Int      @default(0)
  pointsAgainst Int     @default(0)
  pointDiff    Int      @default(0)
  rank         Int?     // Peringkat akhir dalam pool

  matchesAsP1  PoolMatch[] @relation("PoolMatchPlayer1")
  matchesAsP2  PoolMatch[] @relation("PoolMatchPlayer2")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([poolId])
}

// Pertandingan round-robin antar member dalam pool
model PoolMatch {
  id           Int        @id @default(autoincrement())

  poolId       Int
  pool         Pool       @relation(fields: [poolId], references: [id], onDelete: Cascade)

  member1Id    Int
  member1      PoolMember @relation("PoolMatchPlayer1", fields: [member1Id], references: [id])

  member2Id    Int
  member2      PoolMember @relation("PoolMatchPlayer2", fields: [member2Id], references: [id])

  score1       Int?
  score2       Int?
  winnerId     Int?       // ID PoolMember yang menang
  winnerName   String?

  status       MatchStatus @default(SCHEDULED)
  matchOrder   Int         @default(0)

  court        String?    // Nomor lapangan (diatur panitia via /admin/schedule)
  startTime    DateTime?  // Waktu tanding (diatur panitia via /admin/schedule)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([poolId])
}

model Contact {
  id        String   @id @default(uuid())
  nama      String
  email     String
  pesan     String   @db.Text
  createdAt DateTime @default(now())
}

// ============================================================
// SISTEM BAGAN TURNAMEN — FASE GRUP (Round-Robin) [LEGACY]
// ============================================================

model TournamentGroup {
  id           Int            @id @default(autoincrement())
  name         String
  tournamentId Int
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category     String
  members      GroupMember[]
  matches      GroupMatch[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tournamentId, category])
}

model GroupMember {
  id            Int             @id @default(autoincrement())
  groupId       Int
  group         TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  playerName    String
  seedOrder     Int             @default(0)
  played        Int             @default(0)
  wins          Int             @default(0)
  losses        Int             @default(0)
  pointsFor     Int             @default(0)
  pointsAgainst Int             @default(0)
  pointDiff     Int             @default(0)
  rank          Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([groupId])
}

model GroupMatch {
  id           Int             @id @default(autoincrement())
  groupId      Int
  group        TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player1Name  String
  player2Name  String
  score1       Int?
  score2       Int?
  winnerName   String?
  refereeName  String?         // Nama wasit yang memimpin pertandingan ini
  status       MatchStatus     @default(SCHEDULED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([groupId])
}

// ============================================================
// SISTEM BAGAN TURNAMEN — FASE GUGUR (Knockout)
// ============================================================

model KnockoutMatch {
  id           Int         @id @default(autoincrement())
  tournamentId Int
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  category     String
  roundText    String
  matchOrder   Int
  player1Name  String?
  player2Name  String?
  score1       Int?
  score2       Int?
  winnerName   String?
  nextMatchId  Int?
  refereeName  String?     // Nama wasit yang memimpin pertandingan ini
  status       MatchStatus @default(SCHEDULED)

  court        String?    // Nomor lapangan (diatur panitia via /admin/schedule)
  startTime    DateTime?  // Waktu tanding (diatur panitia via /admin/schedule)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tournamentId, category])
}

model OrgStructure {
  id        String   @id @default(cuid())
  name      String
  position  String
  photoUrl  String?
  order     Int      @default(0)

  parentId  String?
  parent    OrgStructure?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  OrgStructure[] @relation("OrgHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// BANNER SLIDER — dikelola lewat /admin/banners
// ============================================================

model Banner {
  id             Int      @id @default(autoincrement())
  tag            String
  title          String
  titleHighlight String   @default("")
  desc           String   @default("")
  image          String
  bgGradient     String   @default("from-primary via-brand to-brand")
  order          Int      @default(0)
  active         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// REKENING BANK — ditampilkan di halaman publik untuk pembayaran
// ============================================================

model BankAccount {
  id            Int      @id @default(autoincrement())
  bankName      String   // Contoh: "BCA", "Mandiri", "BRI"
  accountNumber String   // Nomor rekening
  accountName   String   // Nama pemilik rekening
  logo          String?  // URL logo bank (opsional)
  active        Boolean  @default(true)
  order         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}